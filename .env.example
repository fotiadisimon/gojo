# 复制这个文件为 .env（去掉 .example 后缀），然后填自己的值

# ── LLM 提供商：claude / deepseek 二选一 ──
LLM_PROVIDER=claude

# ── Claude ──
ANTHROPIC_API_KEY=sk-ant-your-key-here
CLAUDE_MODEL=claude-sonnet-4-5-20250929

# ── DeepSeek（可选，用作 Claude 备胎或省钱替代）──
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ── Fish Audio TTS（可选，要用语音播放才需要）──
FISH_KEY=
FISH_VOICE_ID=

# ── 默认角色（App 打开首次会种一个，之后可在 App 里增删改）──
CHARACTER_NAME=小助手
CHARACTER_PROMPT=你是一个温柔耐心的AI助手。说话简洁自然，像朋友聊天一样。
CHARACTER_GREETING=你好呀，今天想聊什么？

# ── 服务 ──
PORT=8080
# DB_PATH=/absolute/path/to/data.db   # 可选；Zeabur 部署时挂载持久卷后设为 /data/gojo.db
